{
  // Hide config files from explorer (they still work, just hidden from view)
  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/node_modules": true,
    "package-lock.json": true,
    "next-env.d.ts": true,
    "postcss.config.mjs": true,
    "eslint.config.mjs": true,
    "components.json": true,
    "tsconfig.json": true,
    "next.config.ts": true
  },
  "deno.enablePaths": ["supabase/functions"],
  "deno.lint": true,
  "deno.unstable": [
    "bare-node-builtins",
    "byonm",
    "sloppy-imports",
    "unsafe-proto",
    "webgpu",
    "broadcast-channel",
    "worker-options",
    "cron",
    "kv",
    "ffi",
    "fs",
    "http",
    "net"
  ],
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
